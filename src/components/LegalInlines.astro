---
import { isBreak, isStrong, type LegalInline } from "../lib/agent/legalCopy"

interface Props {
  nodes: readonly LegalInline[]
}

const { nodes } = Astro.props
---

{
  nodes.map((node) => {
    if (typeof node === "string") return node
    if (isBreak(node)) return <br />
    if (isStrong(node)) return <strong>{node.strong}</strong>
    return node.rel ? (
      <a href={node.href} rel={node.rel}>
        {node.text}
      </a>
    ) : (
      <a href={node.href}>{node.text}</a>
    )
  })
}
