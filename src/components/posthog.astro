const initConfig = {
  api_host: posthogHost,
  defaults: "2026-05-30",
  person_profiles: "identified_only",
  cookieless_mode: "always",
  capture_pageview: true,
  capture_pageleave: true,
  autocapture: true,
  capture_exceptions: true,
  capture_performance: true,
  enable_recording_console_log: true,
  session_recording: {
