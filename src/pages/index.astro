---
export const prerender = false
import Layout from "../layouts/Layout.astro"
import Hero from "../components/Hero"
import { agentCopy } from "../lib/agent/copy"
import { site } from "../config/site"

const home = agentCopy("home")
const homeSections = home.sections ?? []
---

<Layout lockScroll>
  <main class="contents">
    <article class="sr-only">
      <h1>{home.h1}</h1>
      {homeSections.map((section) => (
        <section>
          <h2>{section.h2}</h2>
          <p>{section.body}</p>
        </section>
      ))}
    </article>
    <img
      src={site.asciiPosterSrc}
      alt=""
      width="480"
      height="270"
      decoding="async"
      fetchpriority="high"
      class="hero-ascii-poster"
      aria-hidden="true"
    />
    <Hero client:load />
  </main>
</Layout>
