---
export const prerender = false
import LegalBody from "../components/LegalBody.astro"
import LegalDocument from "../components/LegalDocument.astro"
import { legalDocument } from "../lib/agent/legalCopy"
import { site } from "../config/site"

const doc = legalDocument("terms")
---

<LegalDocument
  title={`${doc.title} | ${site.brand}`}
  description={doc.description}
  heading={doc.heading}
  updated={doc.lastUpdated}
  jsonLdPage="legal"
>
  <LegalBody blocks={doc.blocks} />
</LegalDocument>
