---
export const prerender = false
import SecondaryPage from "../components/SecondaryPage.astro"
import { agentCopy } from "../lib/agent/copy"
import { RECOVERY_PATHS } from "../lib/agent/markdown"
import { SECONDARY_TAP_CLASS } from "../lib/agent/secondaryNav"
import { site } from "../config/site"

const copy = agentCopy("notFound")
---

<SecondaryPage title={`Not found | ${site.brand}`} description={copy.body}>
  <h1 class="mb-4 font-sans text-3xl font-semibold tracking-tight">{copy.h1}</h1>
  <p class="mb-8 font-sans text-sm leading-relaxed text-vesper-accent/85">{copy.body}</p>
  <ul class="flex flex-col gap-2 font-mono text-sm">
    {
      RECOVERY_PATHS.map((href) => (
        <li>
          <a class:list={[SECONDARY_TAP_CLASS, "w-full"]} href={href}>
            {href}
          </a>
        </li>
      ))
    }
  </ul>
</SecondaryPage>
