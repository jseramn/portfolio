---
import globalCss from "../styles/globals.css?inline"
import PostHog from "../components/posthog.astro"
import VercelAnalytics from "../components/VercelAnalytics.astro"
import { buildGraphJsonLd } from "../lib/agent/jsonld"
import { site } from "../config/site"
import geistSans from "../assets/fonts/Geist-Variable.woff2?url"
import SpeedInsights from "@vercel/speed-insights/astro"

interface Props {
  title?: string
  description?: string
  lockScroll?: boolean
  bootPending?: boolean
}

const {
  title = site.seo.title,
  description = site.seo.description,
  lockScroll = false,
  bootPending = false,
} = Astro.props

const lockClass = lockScroll ? "h-dvh overflow-hidden overscroll-none" : ""

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/"
const canonical = pathname === "/" ? site.url : `${site.url}${pathname}`

const sameAs = site.socials
  .filter((s) => !s.href.startsWith("mailto:"))
  .map((s) => s.href)

---

<!doctype html>
<html
  lang="en"
  class:list={["bg-black", lockClass]}
  aria-busy={bootPending ? "true" : undefined}
  data-boot-pending={bootPending ? "" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.seo.keywords} />
    <meta name="author" content={site.name} />
    <meta name="creator" content={site.name} />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      href={geistSans}
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <style is:inline set:html={globalCss} />
    <slot name="head" />
    <link
      rel="alternate"
      type="application/json+oembed"
      href={`${site.url}/oembed.json?url=${encodeURIComponent(canonical)}`}
    />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_CO" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.tagline.en} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:image" content={site.seo.ogImage} />
    <meta property="og:image:alt" content={site.seo.ogImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.tagline.en} />
    <meta name="twitter:site" content={site.seo.twitter} />
    <meta name="twitter:creator" content={site.seo.twitter} />
    <meta name="twitter:image" content={site.seo.ogImage} />
    <meta name="twitter:image:alt" content={site.seo.ogImageAlt} />

    <PostHog />
    <VercelAnalytics />

    <script type="application/ld+json" set:html={JSON.stringify(buildGraphJsonLd(sameAs))} />
  </head>
  <body class:list={["font-sans bg-black text-vesper-accent antialiased", lockClass]}>
    <slot />
  </body>
</html>
