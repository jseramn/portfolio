---
import globalCss from "../styles/globals.css?inline"
import globalCssHref from "../styles/globals.css?url"
import PostHog from "../components/posthog.astro"
import {
  buildGraphJsonLd,
  jsonLdPageKindFromPath,
  jsonLdSameAs,
  type JsonLdPageKind,
} from "../lib/agent/jsonld"
import { site } from "../config/site"
import geistSans from "../assets/fonts/Geist-Variable.woff2?url"
import { VERSION } from "../tinity/content/version"

interface Props {
  title?: string
  description?: string
  lockScroll?: boolean
  bootPending?: boolean
  jsonLdPage?: JsonLdPageKind
  inlineCss?: boolean
  tinity?: boolean
}

const {
  title = site.seo.title,
  description = site.seo.description,
  lockScroll = false,
  bootPending = false,
  jsonLdPage: jsonLdPageProp,
  inlineCss = false,
  tinity = false,
} = Astro.props

const lockClass = lockScroll ? "h-dvh overflow-hidden overscroll-none" : ""

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/"
const canonical = pathname === "/" ? site.url : `${site.url}${pathname}`
const jsonLdPage = jsonLdPageProp ?? jsonLdPageKindFromPath(pathname) ?? "generic"
const sameAs = jsonLdSameAs()
const jsonLd = JSON.stringify(buildGraphJsonLd(sameAs, { kind: jsonLdPage, canonical }))
const homePrefetchRules =
  pathname === "/"
    ? JSON.stringify({
        prefetch: [{ source: "list", urls: ["/about", "/contact"], eagerness: "moderate" }],
      })
    : null
const ogImage = tinity ? `${site.url}/tinity/tinity-og.png` : site.seo.ogImage
const ogImageAlt = tinity
  ? "Tinity lockup: T-tromino mark with LED at the shared vertex and the tinity wordmark"
  : site.seo.ogImageAlt
const faviconSvg = tinity ? "/tinity/favicon.svg" : "/favicon.svg"
const skipHref = tinity ? "#root" : "#main"
const tinityJsonLd = tinity
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareSourceCode",
      name: site.tinity.name,
      codeRepository: site.tinity.repo,
      license: `${site.tinity.repo}/blob/main/LICENSE`,
      programmingLanguage: "TypeScript",
    })
  : null
const tinityState = tinity
  ? JSON.stringify({ version: VERSION, harnesses: 17, status: "idle" })
  : null

---

<!doctype html>
<html
  lang="en"
  class:list={["bg-black", lockClass]}
  aria-busy={bootPending ? "true" : undefined}
  data-boot-pending={bootPending ? "" : undefined}
  data-tinity={tinity ? "" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.seo.keywords} />
    <meta name="author" content={site.name} />
    <meta name="creator" content={site.name} />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonical} />
    <link rel="describedby" href="/llms.txt" />
    <link rel="alternate" type="text/markdown" href={canonical} />
    {tinity && (
      <link
        rel="alternate"
        type="text/markdown"
        href={`${site.url}/tinity/index.md`}
        title="Markdown"
      />
    )}
    <link
      rel="preload"
      href={geistSans}
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    {inlineCss ? (
      <style is:inline set:html={globalCss} />
    ) : (
      <link rel="stylesheet" href={globalCssHref} />
    )}
    <slot name="head" />
    <link
      rel="alternate"
      type="application/json+oembed"
      href={`${site.url}/oembed.json?url=${encodeURIComponent(canonical)}`}
    />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={tinity ? "#1fdb12" : "#000000"} />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_CO" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={tinity ? description : site.tagline.en} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={tinity ? description : site.tagline.en} />
    <meta name="twitter:site" content={site.seo.twitter} />
    <meta name="twitter:creator" content={site.seo.twitter} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <PostHog />

    <script type="application/ld+json" set:html={jsonLd} />
    {tinityJsonLd && (
      <script is:inline type="application/ld+json" set:html={tinityJsonLd} />
    )}
    {tinityState && (
      <script is:inline type="application/json" id="tinity-state" set:html={tinityState} />
    )}
    {homePrefetchRules && (
      <script is:inline type="speculationrules" set:html={homePrefetchRules} />
    )}
  </head>
  <body class:list={["font-sans bg-black text-vesper-accent antialiased", lockClass]}>
    <a class="skip-link" href={skipHref}>Skip to content</a>
    <slot />
  </body>
</html>
